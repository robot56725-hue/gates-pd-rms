# --- Server ---
PORT=3000
NODE_ENV=development
# Set to "true" only when this API sits behind a reverse proxy/load balancer
# you control that overwrites (not appends to) X-Forwarded-For. Otherwise a
# client can spoof its own logged IP address.
TRUST_PROXY=false

# --- Database ---
# The role this connects as must NOT be a superuser or the table owner, or
# the court_ledger/users FORCE ROW LEVEL SECURITY policies from
# db/migrations/001_init_schema.sql have no effect.
DATABASE_URL=postgresql://gates_app_user:CHANGE_ME@localhost:5432/gates_pd_dev
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000

# --- JWT ---
# High-entropy secret (>= 32 bytes), pulled from a secrets manager in
# production. Never commit a real value.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ISSUER=gates-pd-rms
JWT_AUDIENCE=gates-pd-rms-api
# Access token lifetime is intentionally hardcoded to 30 minutes in
# src/controllers/auth.controller.js, not configurable here -- see comment
# there for why.

# --- Encryption ---
# Symmetric key for pgcrypto SSN encryption (see encrypt_ssn/decrypt_ssn in
# db/migrations/001_init_schema.sql). Pull from a secrets manager/KMS in
# production; never commit a real value. Only required if citation
# submissions will include an SSN.
SSN_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://ecitation.gatespd.tn.gov
